# Copy to .env and fill in values. .env is gitignored — never commit secrets.
# Environment variables override config.yml for scalar settings.
# Complex settings (overwrites, block_lists) stay in config.yml.

# Config file path (optional; CLI argument takes precedence)
GO_DNS_CONFIG_FILE=config.yml

# Server
GO_DNS_LISTEN_ADDR=:53

# Cluster (leave empty for standalone)
GO_DNS_ROLE=
GO_DNS_MASTER_API_ADDR=:8053
GO_DNS_MASTER_API_KEY=
GO_DNS_SLAVE_MASTER_URL=
GO_DNS_SLAVE_API_KEY=
GO_DNS_SLAVE_SYNC_INTERVAL=30

# Upstream resolvers (comma-separated; overrides nameservers in config.yml)
GO_DNS_NAMESERVERS=8.8.8.8,8.8.4.4

# Caching
GO_DNS_CACHE_TTL=60
GO_DNS_NEGATIVE_CACHE_TTL=300
GO_DNS_MAX_CACHE_SIZE=0

# Block lists
GO_DNS_RELOAD_INTERVAL=60
GO_DNS_FALLBACK_DNS=8.8.8.8
GO_DNS_DNS_CHECK_DOMAIN=dns.google

# Runtime tuning
GO_DNS_GOGC=100

# Logging (true/false)
GO_DNS_DEBUG=false
GO_DNS_LOG_BLOCKS=false
GO_DNS_LOG_OVERWRITES=false
